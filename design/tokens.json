{
  "$description": "Agent-readable role map. Canonical implementations remain src/app/globals.css and tailwind.config.js; this file must not become a second source of raw values.",
  "sourceOfTruth": {
    "css": "src/app/globals.css",
    "tailwind": "tailwind.config.js"
  },
  "roles": {
    "surface.canvas": { "cssVariable": "--rh-bg", "tailwind": "fusion-bg", "usage": "application and desktop-frame canvas" },
    "surface.base": { "cssVariable": "--rh-surface", "tailwind": "fusion-surface", "usage": "primary panels and modal surfaces" },
    "surface.raised": { "cssVariable": "--rh-surface-raised", "tailwind": "fusion-raised", "usage": "elevated content within a surface" },
    "border.subtle": { "cssVariable": "--rh-border-soft", "tailwind": "fusion-line", "usage": "quiet separation; do not over-outline every group" },
    "text.primary": { "cssVariable": "--rh-text", "tailwind": null, "usage": "primary operational text" },
    "text.muted": { "cssVariable": "--rh-muted", "tailwind": null, "usage": "secondary supporting text; verify contrast in context" },
    "action.primary": { "cssVariable": "--rh-accent", "tailwind": "fusion-accent", "usage": "ready, progress, primary completion and selected focus" },
    "action.primaryHover": { "cssVariable": "--rh-accent-hover", "tailwind": "fusion-accentHover", "usage": "hover state for primary action" },
    "action.onPrimary": { "cssVariable": "--rh-accent-on", "tailwind": "fusion-accentOn", "usage": "content on a solid primary action" },
    "status.warning": { "cssVariable": "--rh-warning", "tailwind": null, "usage": "setup or operational caution" },
    "status.danger": { "cssVariable": "--rh-danger", "tailwind": null, "usage": "destructive or failed operation" },
    "focus.ring": { "cssVariable": "--rh-accent", "tailwind": "fusion-accent", "usage": "visible keyboard/gamepad focus; distinct from selection" },
    "radius.small": { "cssVariable": "--rh-radius-sm", "tailwind": null, "usage": "compact controls and status elements" },
    "radius.medium": { "cssVariable": "--rh-radius-md", "tailwind": null, "usage": "panels and dialogs" },
    "radius.card": { "cssVariable": "--rh-radius-card", "tailwind": null, "usage": "large content cards where already established" }
  }
}
